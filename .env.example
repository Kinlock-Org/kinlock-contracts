# Names and safe placeholders only. Never commit real values.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Name of a Stellar CLI identity in your local keystore (not a key).
STELLAR_ACCOUNT=kinlock-testnet-deployer
# Admin address passed to the constructor at deploy (G… or C…).
KINLOCK_ADMIN=
# Must be 1 (plus interactive confirmation) to deploy to mainnet.
KINLOCK_ALLOW_MAINNET=0
